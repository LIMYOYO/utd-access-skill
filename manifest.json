{
  "manifest_version": 3,
  "name": "UTD Access Skill",
  "version": "0.6.2",
  "version_name": "0.6.2 UTD Top 24 and SSRN preview",
  "description": "Help AI read authorized UTD Top 24 and SSRN full text through the user's browser access.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "downloads",
    "storage",
    "alarms",
    "nativeMessaging"
  ],
  "optional_host_permissions": [
    "https://pubsonline.informs.org/*",
    "https://research.ebsco.com/*",
    "https://papers.ssrn.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Open UTD Access Skill"
  }
}
